        "import re\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "log_file = \"train_log.txt\"\n",
        "\n",
        "pattern = re.compile(\n",
        "    r\"Epoch:\\s*(\\d+),\\s*Steps:\\s*\\d+\\s*\\|\\s*Train Loss:\\s*([0-9.]+)\\s*Vali Loss:\\s*([0-9.]+)\\s*Test Loss:\\s*([0-9.]+)\"\n",
        ")\n",
        "\n",
        "epochs = []\n",
        "train_losses = []\n",
        "vali_losses = []\n",
        "test_losses = []\n",
        "\n",
        "with open(log_file, \"r\") as f:\n",
        "    for line in f:\n",
        "        m = pattern.search(line)\n",
        "        if m:\n",
        "            epoch = int(m.group(1))\n",
        "            train = float(m.group(2))\n",
        "            vali = float(m.group(3))\n",
        "            test = float(m.group(4))\n",
        "\n",
        "            epochs.append(epoch)\n",
        "            train_losses.append(train)\n",
        "            vali_losses.append(vali)\n",
        "            test_losses.append(test)\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"epoch\": epochs,\n",
        "    \"train_loss\": train_losses,\n",
        "    \"vali_loss\": vali_losses,\n",
        "    \"test_loss\": test_losses,\n",
        "})\n",
        "df\n"
